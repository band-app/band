# Port the hub publishes on the host, and the address it binds to.
BAND_PORT=3456
BAND_BIND=127.0.0.1

# Leave empty to get a generated admin token in `docker compose logs band` on the first run.
BAND_ADMIN_TOKEN=

# false runs the hub as an API only.
BAND_SERVE_UI=true
# Origins of a UI hosted elsewhere, comma-separated.
BAND_ALLOWED_ORIGINS=

# Hostname for --profile tls.
BAND_DOMAIN=
