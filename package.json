{
  "name": "band",
  "version": "0.1.0",
  "private": true,
  "description": "IDE-agnostic agent orchestrator",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev:desktop": "pnpm build:cli:desktop && pnpm build:web && pnpm --filter @band-app/desktop build && node scripts/dev-desktop.mjs",
    "dev": "pnpm --filter @band-app/server dev",
    "dev:web": "pnpm dev",
    "dev:docs": "pnpm --filter @band-app/docs dev",
    "build:desktop": "pnpm build:cli:desktop && pnpm build:web && pnpm --filter @band-app/worker build:desktop && pnpm --filter @band-app/desktop build && pnpm --filter @band-app/desktop package",
    "build": "pnpm build:web",
    "build:web": "vp run ci:build-web",
    "build:cli": "pnpm --filter @band-app/cli build",
    "build:cli:desktop": "pnpm --filter @band-app/cli build && node apps/desktop/scripts/copy-cli-binary.mjs",
    "test": "vp run ci:test",
    "lint": "vp run ci:lint",
    "lint:fix": "vp lint --fix && cargo clippy --manifest-path apps/cli/Cargo.toml --fix --allow-dirty",
    "format": "vp run ci:format",
    "format:fix": "vp fmt && cargo fmt --manifest-path apps/cli/Cargo.toml",
    "check": "vp run ci:check",
    "knip": "knip",
    "jscpd": "jscpd .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@band-app/cli": "workspace:^",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "knip": "^6.3.0",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "@trpc/client": "^11.12.0",
    "@trpc/server": "^11.12.0"
  }
}
