{
  "name": "@band-app/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios --no-install",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build:ios-sim": "node scripts/build-ios-sim.mjs"
  },
  "dependencies": {
    "expo": "~57.0.27",
    "expo-camera": "~57.0.0",
    "expo-constants": "~57.0.21",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "@types/react": "~19.2.2",
    "typescript": "^5.7.0"
  }
}
