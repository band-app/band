{
  "name": "@band-app/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --platform ios --no-install",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "lint": "node scripts/check-glyphs.mjs",
    "test": "node scripts/check-glyphs.mjs && node --experimental-strip-types --test tests/*.test.ts",
    "build:ios-sim": "node scripts/build-ios-sim.mjs"
  },
  "dependencies": {
    "@band-app/client": "workspace:^",
    "@band-app/shared": "workspace:^",
    "@mattermost/react-native-paste-input": "2.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.90.21",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-document-picker": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "lowlight": "3.3.0",
    "lucide-react-native": "^1.57.0",
    "marked": "18.1.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-uitextview": "2.7.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.13",
    "@types/react": "~19.2.2",
    "@xterm/headless": "6.1.0-beta.302",
    "typescript": "^5.7.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
