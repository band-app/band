---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import CliCommands from "../../components/CliCommands.astro";
import { allPages } from "../../lib/nav";

export async function getStaticPaths() {
  const pages = await allPages();
  const guides = await getCollection("guides");
  const cli = await getCollection("cli");
  return pages.map((p) => {
    const entry = (p.kind === "cli" ? cli : guides).find((e) => e.id === p.slug)!;
    return { params: { slug: p.slug }, props: { entry, page: p } };
  });
}

const { entry, page } = Astro.props;
const { Content } = await render(entry);
const commands = page.kind === "cli" ? (entry.data as { commands: string[] }).commands : [];
---

<DocsLayout title={`${page.title} | Band docs`} description={page.description}>
  <h1>{page.title}</h1>
  <Content />
  {
    page.kind === "cli" && (
      <>
        <h2 id="commands">Commands</h2>
        <p class="text-sm text-muted-foreground">
          Generated from <code>band schema</code>, so the arguments always match the installed CLI.
        </p>
        <CliCommands commands={commands} />
      </>
    )
  }
</DocsLayout>
