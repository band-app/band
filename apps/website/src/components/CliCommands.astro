---
import schema from "../data/cli-schema.json";

interface Props {
  commands: string[];
}

const { commands } = Astro.props;

type Param = {
  name: string;
  description: string;
  type: string;
  required: boolean;
  positional?: boolean;
};

const entries = schema.commands.filter((c) =>
  commands.some((top) => c.name === top || c.name.startsWith(`${top} `)),
);
---

{
  entries.map((c) => (
    <section class="cli-command">
      <h3 id={c.name.replace(/\s+/g, "-")}>
        <code>band {c.name}</code>
      </h3>
      <p>{c.description}</p>
      {(c.parameters as Param[]).length > 0 && (
        <table>
          <thead>
            <tr>
              <th>Argument</th>
              <th>Type</th>
              <th>Required</th>
              <th>Description</th>
            </tr>
          </thead>
          <tbody>
            {(c.parameters as Param[]).map((p) => (
              <tr>
                <td>
                  <code>{p.positional ? `<${p.name}>` : p.name}</code>
                </td>
                <td>{p.type}</td>
                <td>{p.required ? "yes" : "no"}</td>
                <td>{p.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  ))
}
