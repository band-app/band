{
  "$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "warn",
        "useExhaustiveDependencies": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn"
      },
      "a11y": {
        "useSemanticElements": "warn",
        "noNoninteractiveTabindex": "off",
        "noStaticElementInteractions": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "warn"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "**/*.json",
      "**/*.css",
      "!**/node_modules",
      "!**/dist",
      "!**/dist-builder",
      "!**/build",
      "!**/target",
      "!**/.next",
      "!**/.vinxi",
      "!**/.output",
      "!**/*.gen.ts",
      "!**/.astro",
      "!**/test-results",
      "!**/playwright-report",
      "!**/apps/hub/src/server/infra/db/migrations"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/hub/src/server/services/**", "apps/hub/src/server/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "Services and API handlers reach a machine through the Host (ctx.host / hostRegistry), not node:fs. Hub-state modules are allowlisted in biome.json.",
                  "node:fs/promises": "Services and API handlers reach a machine through the Host (ctx.host / hostRegistry), not node:fs/promises. Hub-state modules are allowlisted in biome.json.",
                  "node:child_process": "Run processes through the Host (host.exec, host.git), not node:child_process. Hub-state modules are allowlisted in biome.json.",
                  "node-pty": "Terminals go through the Host's TerminalBackend; node-pty lives in @band-app/host-local.",
                  "@band-app/host-local/process/exec-file-worker": "Run processes through the Host (host.exec, host.git), not the exec helpers.",
                  "@band-app/host-local/git/git-client": {
                    "importNames": ["execGit", "execGh", "execGhWithInput", "execFileOffThread"],
                    "message": "Run git and gh through the Host (host.git.exec / host.git.gh), not the exec helpers."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/server/services/cli-service.ts",
        "apps/hub/src/server/services/project-avatar-service.ts",
        "apps/hub/src/server/services/_utils/upload-utils.ts",
        "apps/hub/src/server/services/_utils/shared-dir.ts",
        "apps/hub/src/server/services/workspace-service.ts",
        "apps/hub/src/server/api/web-app-manifest.ts",
        "apps/hub/src/server/api/queue/router.ts",
        "apps/hub/src/server/api/browser-host/router.ts",
        "apps/hub/src/server/services/diff-service.ts",
        "apps/hub/src/server/services/project-service.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/hub/src/server/services/github-webhook-service.ts",
        "apps/hub/src/server/services/github-poll-service.ts",
        "apps/hub/src/server/services/pushed-sha-service.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "node:fs": "Services and API handlers reach a machine through the Host (ctx.host / hostRegistry), not node:fs. Hub-state modules are allowlisted in biome.json.",
                  "node:fs/promises": "Services and API handlers reach a machine through the Host (ctx.host / hostRegistry), not node:fs/promises. Hub-state modules are allowlisted in biome.json.",
                  "node:child_process": "Run processes through the Host (host.exec, host.git), not node:child_process. Hub-state modules are allowlisted in biome.json.",
                  "node-pty": "Terminals go through the Host's TerminalBackend; node-pty lives in @band-app/host-local."
                }
              }
            }
          }
        }
      }
    }
  ]
}
