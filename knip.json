{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreWorkspaces": ["apps/cli"],
  "exclude": ["exports", "types", "unresolved"],
  "ignoreBinaries": ["wrangler"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/xterm-patches/regenerate.mjs", "runners/*/*.mjs"],
      "ignoreDependencies": [
        "@band-app/cli",
        "@tanstack/react-query",
        "@trpc/client",
        "@trpc/server"
      ]
    },
    "apps/web": {
      "entry": [
        "src/client.tsx",
        "src/server.ts",
        "src/router.tsx",
        "src/dashboard/index.ts",
        "src/dashboard/adapters/web.ts",
        "src/dashboard/adapters/desktop.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "tests/**/*.ts", "e2e/**/*.ts"],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "class-variance-authority",
        "clsx",
        "tailwind-merge",
        "@tanstack/router-plugin",
        "nanoid",
        "vscode-jsonrpc",
        "@babel/runtime",
        "@codemirror/lint"
      ]
    },
    "apps/hub": {
      "entry": ["bin/band-server.mjs", "terminal-daemon.ts", "src/index.ts", "scripts/*.{mjs,ts}"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.{mjs,ts}", "*.ts"],
      "ignoreDependencies": [
        "typescript-language-server",
        "esbuild",
        "@agentclientprotocol/claude-agent-acp",
        "@agentclientprotocol/codex-acp",
        "@vscode/ripgrep",
        "node-pty"
      ]
    },
    "packages/host-local": {
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": [
        "typescript-language-server",
        "@agentclientprotocol/claude-agent-acp",
        "@agentclientprotocol/codex-acp"
      ]
    },
    "apps/worker": {
      "entry": ["src/main.ts", "src/terminal-daemon.ts", "tests/**/*.test.ts", "scripts/*.mjs"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "bin/*.mjs", "scripts/*.mjs"],
      "ignoreDependencies": [
        "@agentclientprotocol/claude-agent-acp",
        "@agentclientprotocol/codex-acp",
        "@agentclientprotocol/sdk",
        "@vscode/ripgrep",
        "@xterm/addon-serialize",
        "@xterm/addon-unicode11",
        "@xterm/headless",
        "node-pty",
        "pino",
        "typescript-language-server",
        "zod"
      ]
    },
    "apps/desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/index.cts",
        "src/preload/guest.cts",
        "tests/**/*.test.ts",
        "tests/**/*.test.mjs",
        "tests/loader.mjs",
        "scripts/*.mjs"
      ],
      "project": ["src/**/*.{ts,cts}", "tests/**/*.{ts,mjs}", "scripts/**/*.mjs"],
      "ignoreBinaries": ["tsc", "electron", "electron-builder"],
      "ignoreDependencies": ["electron-builder"]
    },
    "apps/website": {
      "entry": ["src/**/*.{astro,ts,tsx}"],
      "project": ["src/**/*.{astro,ts,tsx}"],
      "ignoreDependencies": ["tailwindcss"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/utils.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/coding-agent": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts"]
    },
    "packages/host-api": {
      "entry": ["src/index.ts", "src/contract.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/logger": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/plugin-api": {
      "entry": ["src/index.ts", "src/server.ts", "src/client.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/shared": {
      "entry": ["src/*.ts"],
      "project": ["src/**/*.ts"]
    },
    "plugins/github": {
      "entry": ["src/server/index.ts", "src/client/index.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
